# Optional public Android release discovery. Collection analytics is independent.
# Do not enable either feature before signed APK acceptance and owner approval.
ANDROID_UPDATES_ENABLED=false
ANDROID_RELEASE_DOWNLOADS_ENABLED=false
ANDROID_RELEASES_REPOSITORY=janeshkrish/resqnowfrontend

# Admin sign-in (single admin). Create the hash with: npm run admin:hash-password
# Raise ADMIN_SESSION_VERSION to sign every admin out.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_VERSION=1

# Visitor Tracking & Retention
PAGE_VISIT_RETENTION_DAYS=90
